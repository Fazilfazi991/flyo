# Only SUPABASE_URL and SUPABASE_ANON_KEY are compiled into the browser.
# Current public project values are in data/supabase-config.js.
# Optional build overrides; must be supplied TOGETHER. Never use a service_role/secret key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional hosted integration tests only; never bundled into the site.
CHAT_E2E_URL=http://127.0.0.1:4173
CHAT_TEST_AGENT_EMAIL=
CHAT_TEST_AGENT_PASSWORD=

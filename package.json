{
  "name": "flyo-tours-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node --env-file-if-exists=.env scripts/build-static.js",
    "start": "node --env-file-if-exists=.env scripts/build-static.js && node preview-server.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test"
  },
  "engines": {"node": ">=22"},
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2"
  }
}
